# ==========================================
# DeepSearch-Local Environment Configuration
# ==========================================

# --- Local LLM Serving Engine ---
# Options: "ollama" or "vllm"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
MODEL_NAME=qwen2.5-3b-instruct

# --- Cloud Baseline & Synthetic Data Generation (OpenRouter & RWTH-GPT) ---
# Used for Phase 3 (synthetic trajectory generation) & Phase 6 (evaluation baseline)
OPENROUTER_API_KEY=your_openrouter_api_key_here
CLOUD_BASELINE_MODEL=meta-llama/llama-3.3-70b-instruct
RWTH_GPT_API_KEY=your_rwth_gpt_api_key_here
RWTH_GPT_BASE_URL=https://chat.kiconnect.nrw/api/v1

# --- Dynamic Hybrid RAG & Vector Store (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- Tool Plane (MCP Server) ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# --- Observability & LLMOps (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=true

# --- API Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
